import numpy as np
import matplotlib.pyplot as plt
import matplotlib.cm as cm
from scipy import stats
N1= np.array([500, 1000, 6000,  10000, 40000, 100000, 350000, 500000, 700000, 1000000] )
t1= np.array([26, 27, 31, 33, 40, 40, 44, 48, 49, 53])

N2 = np.array([500, 1000, 6000,  10000, 40000, 100000])
t2 = np.array([63, 71, 88, 90, 115, 114])
N3= np.array([500, 1000, 6000,  10000, 40000, 100000, 350000, 500000, 700000, 1000000] )
t3= np.array([22, 25, 28, 27, 30, 31, 32, 35, 34, 33])
plt.xscale('log')
plt.scatter(N1, t1, color='red', s=15, marker='o', label='binar search (not random) средний случай', alpha=0.8, edgecolors='black', linewidth=1)
plt.scatter(N2, t2, color='blue', s=15, marker='o', label='binar search (random) средний случай', alpha=0.8, edgecolors='black', linewidth=1)
plt.scatter(N3, t3, color='black', s=15, marker='s', label='binar search (худший случай)', alpha=0.8, edgecolors='black', linewidth=1)
plt.xlabel('lnN', fontsize=10)
plt.ylabel('t, время на 1.000.000 запусков', fontsize=10)
plt.title('Зависимость t(ln(N)) для s_binary', fontsize=12)
plt.grid(True, alpha=0.3)
plt.legend(fontsize=10, loc='upper left')